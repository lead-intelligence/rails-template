#!/usr/bin/env ruby
# Runs again, alone, the tests a failed bin/ci named (.github/workflows/ci.yml):
# a test that passes then failed only once, as a system test may when the
# machine is slow, and a second whole run would take as long as the first.
# When a step that is not a test failed, or coverage fell, or the log names
# no test, the failure is real and nothing runs again. Peronix's build
# sandbox follows the same rule.
#
#   bin/rerun-failed-tests tmp/ci.log
lines = File.read(ARGV.fetch(0), encoding: "UTF-8").scrub.gsub(/\e\[[\d;?]*[A-Za-z]/, "").lines(chomp: true)
steps = lines.filter_map { |line| line[/\A❌ (.+) failed in /, 1] } - [ "Continuous Integration" ]
tests = lines.filter_map { |line| line[%r{\Abin/rails test (\S+:\d+)}, 1] }.uniq

if (other = steps.reject { |step| step.start_with?("Tests:") }).any?
  abort "Not a test: #{other.join(", ")} failed."
elsif lines.any? { |line| line.include?("below the expected minimum coverage") }
  abort "The coverage fell below its minimum."
elsif tests.empty?
  abort "bin/ci names no failed test to run again."
end

puts "SKIP_COVERAGE=1 bin/rails test #{tests.join(" ")}"
$stdout.flush
exec({ "SKIP_COVERAGE" => "1" }, ENV.fetch("RERUN_RAILS", "bin/rails"), "test", *tests)
