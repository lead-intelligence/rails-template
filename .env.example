OPENAI_API_KEY=sk-your-key-here

# Optional: override the OpenAI chat/embedding models. Changing the embedding model requires a migration
# (Document::EMBEDDING_DIMENSIONS = 1536 is tied to text-embedding-3-small's output size), so it is deliberately
# not exposed anywhere but here.
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: user feedback -> GitHub Issues. Both must be set, or feedback is only stored locally.
# GITHUB_ISSUES_TOKEN=github_pat_your-fine-grained-token
# GITHUB_ISSUES_REPO=your-org/your-repo

# Superadmin basic auth — one credential pair gates every developer-only panel: /errors, /onlylogs,
# /admin/feedbacks, /jobs, /madmin, /models, /railspress/admin and the /docs documentation site.
# Access is denied (401) until both are set.
# Never commit real values; share one pair across apps via your password manager and .kamal/secrets.
# SUPERADMIN_USER=superadmin
# SUPERADMIN_PASSWORD=a-strong-password

# Optional: Solid Errors emails a notification for each new exception when this is set.
# SOLID_ERRORS_EMAIL_TO=you@example.com

# Optional: bearer token for GET /error_feed, the feed an outside watcher reads new errors from.
# The endpoint answers 404 until this (or error_feed_token in credentials) is set.
# ERROR_FEED_TOKEN=a-long-random-token

# Production email. APP_HOST is the domain used in mailer links (set it before deploying).
# SMTP_* configure outgoing delivery for any provider (SendGrid, Postmark, Mailgun, SES, Resend, ...).
# Prefer storing the SMTP username/password in credentials (smtp/user_name, smtp/password); ENV is the fallback.
# APP_HOST=your-app.com
# SMTP_ADDRESS=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER_NAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password

# Backups. The kamal-backup accessory in config/deploy.yml is active by default and refuses to boot until
# config/kamal-backup.yml names a restic repository and these three are uncommented in .kamal/secrets
# (they are Kamal secrets, not app ENV — they are listed here so nothing about a deploy is a surprise).
# RESTIC_PASSWORD=a-strong-passphrase
# AWS_ACCESS_KEY_ID=your-object-storage-key
# AWS_SECRET_ACCESS_KEY=your-object-storage-secret
