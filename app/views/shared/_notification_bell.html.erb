<% unread_count = unread_notifications_count %>
<% recent = recent_notifications %>

<details class="dropdown dropdown-end" data-controller="dropdown">
  <summary class="btn btn-ghost btn-circle" aria-label="<%= t("shared.notification_bell.aria_label") %>">
    <div class="indicator">
      <%= lucide_icon("bell", class: "size-5") %>
      <% if unread_count.positive? %>
        <span class="badge badge-xs badge-primary indicator-item"><%= unread_count %></span>
      <% end %>
    </div>
  </summary>
  <div class="dropdown-content z-40 mt-2 w-80 rounded-box border border-base-300 bg-base-100 p-2 shadow-lg">
    <div class="flex items-center justify-between px-2 py-1">
      <span class="font-semibold"><%= t("shared.notification_bell.title") %></span>
      <% if unread_count.positive? %>
        <%= button_to t("shared.notification_bell.mark_all_read"), mark_all_read_notifications_path, method: :patch, class: "btn btn-ghost btn-xs" %>
      <% end %>
    </div>
    <ul class="menu w-full">
      <% if recent.any? %>
        <% recent.each do |notification| %>
          <li><%= render "notifications/notification", notification: notification %></li>
        <% end %>
      <% else %>
        <li>
          <div class="flex flex-col items-center gap-2 py-6 text-base-content/60">
            <%= lucide_icon("bell-off", class: "size-6") %>
            <span><%= t("shared.notification_bell.empty") %></span>
          </div>
        </li>
      <% end %>
    </ul>
    <div class="text-center mt-2">
      <%= link_to t("shared.notification_bell.see_all"), notifications_path, class: "link link-sm" %>
    </div>
  </div>
</details>
