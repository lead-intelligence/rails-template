<%= native_form_tag %>
<div class="flex justify-center py-16">
  <div class="card border border-base-300 bg-base-100 shadow-sm w-full max-w-md">
    <div class="card-body">
      <h1 class="card-title"><%= t(".title") %></h1>
      <%= form_with url: session_url do |form| %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: t(".email_placeholder"), value: params[:email_address], class: "input input-bordered w-full" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: t(".password_placeholder"), maxlength: 72, class: "input input-bordered w-full mt-4" %>
        <%= form.submit t(".sign_in"), class: "btn btn-primary w-full mt-4" %>
      <% end %>
      <div class="text-center mt-4">
        <%= link_to t(".forgot_password"), new_password_path, class: "link" %>
      </div>
    </div>
  </div>
</div>
