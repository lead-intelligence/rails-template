<% error_message = tool.tool_error_message %>
<% if error_message.present? %>
  <%= render "messages/error",
    message: tool,
    title: t(".error_title"),
    error_message: error_message %>
<% else %>
  <div id="message_<%= tool.id %>" data-version="<%= tool.broadcast_version %>" class="w-full sm:w-auto my-5 space-y-3 rounded-box px-3 py-2 bg-base-200 border border-base-300">
    <div>
      <span class="badge badge-neutral badge-sm">
        <%= t(".label") %>
      </span>
    </div>

    <pre class="whitespace-pre-wrap text-sm overflow-x-auto"><%= tool.content.presence || t(".no_output") %></pre>

    <div>
      <span class="text-xs opacity-70"><%= l(tool.created_at, format: :hour) if tool.created_at %></span>
    </div>
  </div>
<% end %>
