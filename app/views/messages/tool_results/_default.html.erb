<% error_message = tool.tool_error_message %>
<% if error_message.present? %>
  <%= render "messages/error",
    message: tool,
    title: t(".error_title"),
    error_message: error_message %>
<% else %>
  <div id="message_<%= tool.id %>" data-version="<%= tool.broadcast_version %>" class="w-full sm:w-auto my-5 space-y-3 rounded-md px-3 py-2 bg-gray-50 border border-gray-200">
    <div>
      <span class="inline-block rounded px-2 py-0.5 text-xs font-medium bg-gray-200 text-gray-700">
        <%= t(".label") %>
      </span>
    </div>

    <pre class="whitespace-pre-wrap text-gray-700 text-sm overflow-x-auto"><%= tool.content.presence || t(".no_output") %></pre>

    <div>
      <span class="text-sm text-gray-600"><%= l(tool.created_at, format: :hour) if tool.created_at %></span>
    </div>
  </div>
<% end %>
