<div id="message_<%= message.id %>" data-version="<%= message.broadcast_version %>" class="alert alert-error w-full sm:w-auto my-5 flex flex-col items-start">
  <div>
    <span class="text-xs font-bold">
      <%= title.presence || t(".title") %>
    </span>
  </div>

  <pre class="whitespace-pre-wrap text-sm overflow-x-auto"><%= error_message %></pre>

  <div>
    <span class="text-xs"><%= l(message.created_at, format: :hour) if message.created_at %></span>
  </div>
</div>
