<% system ||= local_assigns[:message] %>
<div id="message_<%= system.id %>" data-version="<%= system.broadcast_version %>" class="w-full sm:w-auto my-5 space-y-3 rounded-box px-3 py-2 bg-base-200 border border-base-300">
  <div>
    <span class="badge badge-neutral badge-sm">
      <%= t(".label") %>
    </span>
  </div>

  <div class="whitespace-pre-wrap"><%= system.content %></div>
</div>
