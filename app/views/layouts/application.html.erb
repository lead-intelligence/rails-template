<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <%= display_meta_tags site: "CharcoTemplate", reverse: true %>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Charco Template">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "lexxy", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :charco_mobile, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= native_identity_tag Current.user&.id %>
    <%= native_tabs_tag if authenticated? %>
    <%= native_badge_tag unread_notifications_count if authenticated? %>
    <%= native_push_tag if authenticated? %>
    <%= native_toast_tag flash[:notice] if native_app? %>
    <%= render "shared/native_navbar" if native_app? %>
    <%= render "shared/navbar" unless native_app? %>
    <%= render "shared/flash" %>
    <%= render "shared/confirm_dialog" %>
    <main class="w-full px-5 sm:px-8 flex flex-col <%= native_app? ? "native-inset" : "mt-6" %>">
      <%= yield %>
    </main>

    <% if authenticated? %>
      <%= render "support_chats/widget" %>
    <% end %>
  </body>
</html>
