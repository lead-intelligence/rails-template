<% row_id = [model.provider, model.id].join("_").parameterize(separator: "_") %>
<tr id="model_<%= row_id %>">
  <td><%= model.provider_class&.name || model.provider %></td>
  <td><%= model.name %></td>
  <td><%= number_with_delimiter(model.context_window) if model.context_window %></td>
  <td>
    <% input = model.price(:input) %>
    <% output = model.price(:output) %>
    <% if input && output %>
      $<%= "%.2f" % input %> / $<%= "%.2f" % output %>
    <% end %>
  </td>
  <td>
    <%= link_to t(".start_chat"), new_chat_path(model: model.id), class: "link link-primary" %>
  </td>
</tr>
