<% set_meta_tags title: t(".meta_title") %>
<div class="py-6 w-full">
  <div class="flex justify-between items-center mb-6">
    <h1 class="font-bold text-4xl"><%= t(".title") %></h1>
    <% if @pagy.count > 1 %>
      <%= button_to t(".revoke_others"), revoke_others_active_sessions_path, method: :delete,
            class: "btn btn-sm btn-primary", data: { turbo_confirm: t(".confirm") } %>
    <% end %>
  </div>

  <p class="text-sm text-base-content/70 mb-4"><%= t(".inactivity_rule", days: Session::INACTIVITY_LIMIT.in_days.to_i) %></p>

  <ul id="sessions" class="list bg-base-100 rounded-box shadow">
    <% @sessions.each do |active_session| %>
      <li class="list-row items-center">
        <div class="list-col-grow min-w-0">
          <div class="flex items-center gap-2">
            <span><%= active_session.ip_address %></span>
            <% if active_session == Current.session %>
              <span class="badge badge-primary"><%= t(".this_device") %></span>
            <% end %>
          </div>
          <div class="text-sm text-base-content/70"><%= active_session.user_agent.to_s.truncate(80) %></div>
          <div class="text-sm text-base-content/70"><%= l(active_session.created_at, format: :short) %></div>
        </div>
        <%= button_to t(".revoke"), active_session_path(active_session), method: :delete,
              class: "btn btn-error btn-sm", data: { turbo_confirm: t(".confirm") } %>
      </li>
    <% end %>
  </ul>
  <%= render "shared/pagination", pagy: @pagy %>
</div>
