<div class="p-6 max-w-4xl mx-auto w-full">
  <h1 class="font-bold text-4xl mb-6"><%= t(".title") %></h1>

  <% if @posts.any? %>
    <div class="grid gap-6">
      <% @posts.each do |post| %>
        <article class="card border border-base-300 bg-base-100 shadow-sm">
          <% if post.header_image.attached? %>
            <figure><%= image_tag post.header_image, class: "w-full h-48 object-cover" %></figure>
          <% end %>
          <div class="card-body">
            <% if post.category %>
              <%= link_to post.category.name, blog_path(category: post.category.slug), class: "badge badge-primary" %>
            <% end %>
            <h2 class="card-title">
              <%= link_to post.title, blog_post_path(post.slug), class: "link link-hover" %>
            </h2>
            <p class="text-sm text-base-content/60"><%= l(post.published_at.to_date, format: :long) %></p>
            <% if post.tags.any? %>
              <div class="flex flex-wrap gap-1 mt-2">
                <% post.tags.each do |tag| %>
                  <%= link_to "##{tag.name}", blog_path(tag: tag.slug), class: "badge badge-ghost badge-sm" %>
                <% end %>
              </div>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
    <%= render "shared/pagination", pagy: @pagy %>
  <% else %>
    <p class="text-base-content/60"><%= t(".empty") %></p>
  <% end %>
</div>
