<%= native_form_tag %>
<% set_meta_tags title: t(".meta_title") %>
<div class="flex flex-col items-center gap-6 py-16">
  <% if @user.errors.any? %>
    <div class="alert alert-error w-full max-w-md"><%= @user.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="card bg-base-100 shadow w-full max-w-md">
    <div class="card-body">
      <%= render "users/avatar", user: Current.user %>
      <h1 class="card-title"><%= t(".title") %></h1>
      <%= form_with model: @user, url: profile_path, method: :patch do |form| %>
        <%= form.label :name, class: "label" %>
        <%= form.text_field :name, class: "input input-bordered w-full", required: true, maxlength: User::NAME_MAX_LENGTH %>
        <%= form.label :avatar, class: "label" %>
        <%= form.file_field :avatar, class: "file-input file-input-bordered w-full" %>
        <%= form.submit t(".save"), class: "btn btn-primary w-full mt-4" %>
      <% end %>
    </div>
  </div>

  <div class="card bg-base-100 shadow w-full max-w-md">
    <div class="card-body">
      <h2 class="card-title"><%= t(".security_title") %></h2>
      <p class="text-sm text-base-content/70"><%= t(".current_email", email: @user.email_address) %></p>
      <% if @user.unconfirmed_email.present? %>
        <p class="text-sm text-warning"><%= t(".pending_email", email: @user.unconfirmed_email) %></p>
      <% end %>
      <%= form_with model: @user, url: profile_path, method: :patch do |form| %>
        <%= form.label :unconfirmed_email, t(".new_email_label"), class: "label" %>
        <%= form.email_field :unconfirmed_email, autocomplete: "email", class: "input input-bordered w-full" %>
        <%= form.label :password, t(".new_password_label"), class: "label" %>
        <%= form.password_field :password, autocomplete: "new-password", class: "input input-bordered w-full" %>
        <%= form.label :password_confirmation, t(".new_password_confirmation_label"), class: "label" %>
        <%= form.password_field :password_confirmation, autocomplete: "new-password", class: "input input-bordered w-full" %>
        <p class="text-sm text-base-content/70 mt-2"><%= t(".current_password_hint") %></p>
        <%= form.label :password_challenge, t(".password_label"), class: "label" %>
        <%= form.password_field :password_challenge, required: true, autocomplete: "current-password", class: "input input-bordered w-full" %>
        <%= form.submit t(".save"), class: "btn btn-primary w-full mt-4" %>
      <% end %>
    </div>
  </div>

  <div class="card bg-base-100 shadow w-full max-w-md">
    <div class="card-body">
      <h2 class="card-title"><%= t(".export_title") %></h2>
      <p class="text-sm text-base-content/70"><%= t(".export_hint") %></p>
      <%= button_to t(".export_data"), data_export_path, class: "btn btn-outline w-full mt-2" %>
    </div>
  </div>

  <div class="card bg-base-100 border border-error w-full max-w-md">
    <div class="card-body">
      <h2 class="card-title text-error"><%= t(".danger_zone") %></h2>
      <p class="text-sm text-base-content/70"><%= t(".delete_warning") %></p>
      <%= form_with url: registration_path, method: :delete, class: "contents" do |form| %>
        <p class="text-sm mt-2"><%= t(".confirmation_hint_html", phrase: tag.strong(t("registrations.destroy.confirmation_phrase"))) %></p>
        <%= form.label :confirmation, t(".confirmation_label"), class: "label" %>
        <%= form.text_field :confirmation, required: true, autocomplete: "off", class: "input input-bordered w-full" %>
        <%= form.label :password, t(".password_label"), class: "label" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", class: "input input-bordered w-full" %>
        <%= form.submit t(".delete_account"), class: "btn btn-error w-full mt-4" %>
      <% end %>
    </div>
  </div>
</div>
