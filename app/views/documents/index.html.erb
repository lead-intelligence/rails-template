<% content_for :title, t(".title") %>

<div class="py-6 w-full">
  <div class="flex justify-between items-center mb-6">
    <h1 class="font-bold text-4xl"><%= t(".title") %></h1>
    <%= link_to t(".new_document"), new_document_path, class: "btn btn-primary" %>
  </div>

  <%= native_search_tag target: "#q", placeholder: t(".search_placeholder") %>
  <%= form_with url: documents_path, method: :get, class: "join w-full mb-6 native-hidden" do |form| %>
    <%= form.text_field :q, value: params[:q], placeholder: t(".search_placeholder"), class: "input input-bordered join-item w-full" %>
    <%= form.submit t(".search"), class: "btn btn-primary join-item" %>
  <% end %>
  <%= native_scan_button_tag t(".scan"), target: "#q", submit: true, id: "scan", class: "btn btn-block mb-6 native-only" %>

  <% if @documents.any? %>
    <ul class="list bg-base-100 rounded-box shadow">
      <% @documents.each do |document| %>
        <li class="list-row items-center">
          <%= link_to document.title, document, class: "list-col-grow min-w-0 truncate" %>
        </li>
      <% end %>
    </ul>
    <%= render "shared/pagination", pagy: @pagy if @pagy %>
  <% else %>
    <p class="text-center my-10"><%= t(".empty") %></p>
  <% end %>
</div>
