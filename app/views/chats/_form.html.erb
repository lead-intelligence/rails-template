<%= native_form_tag %>
<%= form_with(model: chat, url: chats_path, class: "contents") do |form| %>
  <% if chat.errors.any? %>
    <div id="error_explanation" class="alert alert-error mt-3 flex flex-col items-start">
      <h2><%= t(".errors", count: chat.errors.count) %></h2>

      <ul class="list-disc ml-6">
        <% chat.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :model, t(".model_label") %>
    <%= form.select :model,
        options_for_select(@chat_models.map { |model| [model.label, model.id] }.unshift([default_model_display_name, nil]), @selected_model),
        {},
        class: ["select select-bordered mt-2 w-full", {"select-error": chat.errors[:model].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :prompt, t(".prompt_label") %>
    <%= form.text_area :prompt, rows: 4, placeholder: t(".prompt_placeholder"), autofocus: true, required: true, maxlength: Message::CONTENT_MAX_LENGTH,
        class: ["textarea textarea-bordered mt-2 w-full", {"textarea-error": chat.errors[:prompt].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit t(".submit"), class: "btn btn-primary w-full sm:w-auto" %>
  </div>
<% end %>
