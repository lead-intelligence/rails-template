<%= native_keyboard_tag(toolbar: false) %>
<% content_for :title, t(".title") %>

<%= turbo_stream_from "chat_#{@chat.id}" %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl"><%= t(".heading", id: @chat.id) %></h1>

  <div class="my-5">
    <strong class="block font-medium mb-1"><%= t(".model") %></strong>
    <%= @chat.model&.label || default_model_display_name %>
  </div>

  <div id="chat_<%= @chat.id %>_messages" class="min-w-full divide-y divide-gray-200 space-y-5 my-5">
    <%= render "older_messages", chat: @chat, pagy: @pagy %>
    <% @messages.each do |message| %>
      <%= render message %>
    <% end %>
  </div>

  <%= render "messages/composer", chat: @chat, message: @message %>

  <%= link_to t(".back"), chats_path, class: "btn btn-ghost mt-2" %>
</div>
